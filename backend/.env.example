# ---- Application ----
PROJECT_NAME="FastAPI Auth & User Management"
DEBUG=true

# ---- MongoDB ----
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="auth_system"

# ---- JWT ----
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="CHANGE_ME_super_secret_key_for_local_dev_only"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- CORS (comma separated) ----
CORS_ORIGINS_RAW="http://localhost:5173,http://127.0.0.1:5173"

# ---- First admin bootstrap (used by seed.py) ----
FIRST_ADMIN_EMAIL="admin@example.com"
FIRST_ADMIN_PASSWORD="Admin1234"
